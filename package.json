{
  "name": "aperture-router",
  "version": "1.0.0",
  "description": "Adaptive sub-millisecond open-weight model router and evaluation harness for LLMs and SLMs",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "aperture": "./src/index.js"
  },
  "scripts": {
